{
  "exercise": "pushup",
  "version": 2,
  "calibrated": true,
  "_note": "calibrate.py가 만든 파일 (AI Hub 데이터, MediaPipe lite 1회 단위). 웹캠 실측으로는 아직 검증 안 함. _ba_rep = 하루씩 빼고 검증한 1회 균형정확도. 손으로 고치지 말고 calibrate.py를 고쳐 다시 만든다. 2026-11-28: count_threshold, depth 목표 각도·감점, hand_width는 데이터 없이 정한 고정값 (calibrate.py에 같이 반영).",
  "primary_feature": "elbow_angle",
  "up_threshold": 150,
  "count_threshold": 145,
  "min_rep_seconds": 0.6,
  "smoothing": 0.6,
  "min_keypoint_conf": 0.3,
  "score_step": 10,
  "depth": {
    "code": "shallow_depth",
    "target": 125,
    "tolerance": 0,
    "penalty_per_degree": 2.0,
    "min_score": 60
  },
  "form_checks": [
    {
      "code": "hand_width",
      "feature": "hand_out",
      "stat": "mean",
      "limit": 0.25,
      "direction": "above",
      "full_at": 0.5,
      "penalty": 20,
      "tier": "medium",
      "live": true,
      "enabled": true,
      "_note": "어깨-손목 위치 고정 규칙 (데이터 라벨 없음). 웹캠으로 조정"
    },
    {
      "code": "body_line",
      "feature": "body_line",
      "stat": "min",
      "limit": 155,
      "penalty": 20,
      "enabled": false,
      "_note": "측면 촬영용 초기값. 정면 카메라에서는 끔 (HANDOFF.md)"
    }
  ],
  "judge": {
    "type": "threshold"
  }
}
