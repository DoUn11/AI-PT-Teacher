# dev: JWT_SECRET 미설정 시 개발용 임시 키 사용 / 그 외 환경에서는 JWT_SECRET 필수
APP_ENV=dev
DATABASE_URL=sqlite:///./aipt.db
# 운영 예시: postgresql+psycopg://user:password@host:5432/aipt
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase 동기화(선택). 키가 없으면 로컬 DB만 사용
# FIREBASE_CREDENTIALS=app/core/serviceAccountkey.json

# Pi 카메라 수신(MQTT). 비워 두면 꺼짐. 브로커는 ../raspberry/mosquitto.conf 참고
# MQTT_URL=mqtt://localhost:1883
# MQTT_FRAME_TOPIC=ai_pt/cam/frame
# MQTT_ANALYZED_TOPIC=ai_pt/cam/analyzed
# MQTT_ANALYSIS_TOPIC=ai_pt/cam/analysis
# MQTT_CONTROL_TOPIC=ai_pt/cam/control
# CAMERA_OFFLINE_AFTER_SECONDS=5
